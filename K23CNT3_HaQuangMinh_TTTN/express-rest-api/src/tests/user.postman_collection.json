                  "pm.test('TC03: Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('TC03: success = true', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('TC03: message đúng', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.eql('Tạo user thành công.');",
                  "});",
                  "",
                  "pm.test('TC03: data có _id', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('_id');",
                  "    // Lưu user_id để dùng cho các test case tiếp theo",
                  "    pm.collectionVariables.set('user_id', json.data._id);",
                  "    console.log('Saved user_id:', json.data._id);",
                  "});",
                  "",
                  "pm.test('TC03: data.name đúng', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.name).to.eql('Nguyen Van A');",
                  "});",
