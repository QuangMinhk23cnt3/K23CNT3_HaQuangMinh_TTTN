                  "pm.test('TC03: data.email đúng', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.email).to.eql('nguyenvana@example.com');",
                  "});",
                  "",
                  "pm.test('TC03: data.age đúng', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.age).to.eql(25);",
                  "});",
                  "",
                  "pm.test('TC03: data có createdAt và updatedAt', function () {",
                  "    const json = pm.response.json();",
