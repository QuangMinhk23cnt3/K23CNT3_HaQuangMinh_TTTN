    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL của server"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string",
      "description": "MongoDB ObjectId của user vừa tạo (auto-set bởi TC03)"
