      "name": "Suite 6: Health Check",
      "item": [
        {
          "name": "TC20 - Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC20: Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('TC20: message đúng', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.eql('Express + MongoDB API is running');",
                  "});",
                  "",
                  "pm.test('TC20: có field docs', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('docs');",
                  "    pm.expect(json.docs).to.include('/api-docs');",
                  "});",
                  "",
                  "pm.test('TC20: có field version', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('version');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "TC20: Kiểm tra health check endpoint"
          }
        }
      ]
    },
