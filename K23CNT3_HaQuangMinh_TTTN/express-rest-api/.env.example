PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/express_demo

JWT_ACCESS_SECRET=your_super_long_access_secret_change_me_in_production
JWT_REFRESH_SECRET=your_super_long_refresh_secret_change_me_in_production

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email SMTP (tùy chọn)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=yourgmail@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Đặt false hoặc bỏ trống nếu không bắt buộc xác thực email để đăng nhập
REQUIRE_EMAIL_VERIFY=false

CLIENT_URL=*

EMAIL_VERIFY_EXPIRES_MINUTES=15
RESET_PASSWORD_EXPIRES_MINUTES=15

GEMINI_API_KEY=your_gemini_api_key_here
